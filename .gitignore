__pycache__/
*.pyc
.venv/
*.env

# Nada em data/ vai para o repo (BD, extratos reais, inbox...), excepto os exemplos sintéticos.
data/*
!data/samples/
# backups automáticos da BD (já cobertos por data/*, explícito por segurança) e qualquer .db fora dos exemplos
data/backups/
*.db
!data/samples/*.db
